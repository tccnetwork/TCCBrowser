{
  "description": "Accepting and rejecting manifests. The largest attack surface: everything downstream trusts the verdict reached here, and this runs BEFORE the signature is verified, because the public key lives inside the manifest. Every rejecting case names a stable error code. See FORMAT.md.",
  "cases": [
    {
      "case": "minimal manifest, no capabilities requested",
      "expect_pass": true,
      "manifest": {
        "spec_version": "0.1",
        "id": "com.tcc.hello",
        "name": "Xin chào",
        "version": "1.0.0",
        "publisher": "PUB",
        "scheme": "hybrid-ed25519-mldsa65-v1",
        "content_hash": "HASH",
        "entry": "ui.json",
        "capabilities": []
      }
    },
    {
      "case": "app id missing a dot",
      "expect_pass": false,
      "code": "bad-app-id",
      "manifest": {
        "spec_version": "0.1",
        "id": "hello",
        "name": "A",
        "version": "1",
        "publisher": "PUB",
        "scheme": "hybrid-ed25519-mldsa65-v1",
        "content_hash": "HASH",
        "entry": "ui.json",
        "capabilities": []
      }
    },
    {
      "case": "app id contains uppercase",
      "expect_pass": false,
      "code": "bad-app-id",
      "manifest": {
        "spec_version": "0.1",
        "id": "com.TCC.hello",
        "name": "A",
        "version": "1",
        "publisher": "PUB",
        "scheme": "hybrid-ed25519-mldsa65-v1",
        "content_hash": "HASH",
        "entry": "ui.json",
        "capabilities": []
      }
    },
    {
      "case": "unknown spec_version",
      "expect_pass": false,
      "code": "unsupported-spec-version",
      "manifest": {
        "spec_version": "99.0",
        "id": "com.tcc.a",
        "name": "A",
        "version": "1",
        "publisher": "PUB",
        "scheme": "hybrid-ed25519-mldsa65-v1",
        "content_hash": "HASH",
        "entry": "ui.json",
        "capabilities": []
      }
    },
    {
      "case": "app name contains a bidi override",
      "expect_pass": false,
      "code": "unsafe-display-string",
      "manifest": {
        "spec_version": "0.1",
        "id": "com.tcc.a",
        "name": "Hu‮r",
        "version": "1",
        "publisher": "PUB",
        "scheme": "hybrid-ed25519-mldsa65-v1",
        "content_hash": "HASH",
        "entry": "ui.json",
        "capabilities": []
      }
    },
    {
      "case": "app name contains a zero-width character",
      "expect_pass": false,
      "code": "unsafe-display-string",
      "manifest": {
        "spec_version": "0.1",
        "id": "com.tcc.a",
        "name": "TCC​Store",
        "version": "1",
        "publisher": "PUB",
        "scheme": "hybrid-ed25519-mldsa65-v1",
        "content_hash": "HASH",
        "entry": "ui.json",
        "capabilities": []
      }
    },
    {
      "case": "same capability requested twice",
      "expect_pass": false,
      "code": "duplicate-capability",
      "manifest": {
        "spec_version": "0.1",
        "id": "com.tcc.a",
        "name": "A",
        "version": "1",
        "publisher": "PUB",
        "scheme": "hybrid-ed25519-mldsa65-v1",
        "content_hash": "HASH",
        "entry": "ui.json",
        "capabilities": [
          {
            "name": "network",
            "scope": {
              "kind": "network",
              "hosts": [
                "a.tcc-coin.com"
              ]
            },
            "reason": "vo hai"
          },
          {
            "name": "network",
            "scope": {
              "kind": "network",
              "hosts": [
                "ke-gian.example"
              ]
            },
            "reason": "muc that"
          }
        ]
      }
    },
    {
      "case": "non-ASCII hostname (Cyrillic o in shop)",
      "expect_pass": false,
      "code": "non-ascii-host",
      "manifest": {
        "spec_version": "0.1",
        "id": "com.tcc.a",
        "name": "A",
        "version": "1",
        "publisher": "PUB",
        "scheme": "hybrid-ed25519-mldsa65-v1",
        "content_hash": "HASH",
        "entry": "ui.json",
        "capabilities": [
          {
            "name": "network",
            "scope": {
              "kind": "network",
              "hosts": [
                "shоp.tcc-coin.com"
              ]
            },
            "reason": "tai hang"
          }
        ]
      }
    },
    {
      "case": "capability not in the standard",
      "expect_pass": false,
      "code": "unknown-capability",
      "manifest": {
        "spec_version": "0.1",
        "id": "com.tcc.a",
        "name": "A",
        "version": "1",
        "publisher": "PUB",
        "scheme": "hybrid-ed25519-mldsa65-v1",
        "content_hash": "HASH",
        "entry": "ui.json",
        "capabilities": [
          {
            "name": "camera",
            "scope": {
              "kind": "network",
              "hosts": [
                "a.tcc-coin.com"
              ]
            },
            "reason": "x"
          }
        ]
      }
    },
    {
      "case": "empty reason",
      "expect_pass": false,
      "code": "missing-reason",
      "manifest": {
        "spec_version": "0.1",
        "id": "com.tcc.a",
        "name": "A",
        "version": "1",
        "publisher": "PUB",
        "scheme": "hybrid-ed25519-mldsa65-v1",
        "content_hash": "HASH",
        "entry": "ui.json",
        "capabilities": [
          {
            "name": "network",
            "scope": {
              "kind": "network",
              "hosts": [
                "a.tcc-coin.com"
              ]
            },
            "reason": "   "
          }
        ]
      },
      "notes": "The correct code is `missing-reason`, not `unsafe-display-string`: an empty reason is a missing field, not a dangerous string."
    },
    {
      "case": "entry point escapes the package",
      "expect_pass": false,
      "code": "bad-entry",
      "manifest": {
        "spec_version": "0.1",
        "id": "com.tcc.a",
        "name": "A",
        "version": "1",
        "publisher": "PUB",
        "scheme": "hybrid-ed25519-mldsa65-v1",
        "content_hash": "HASH",
        "entry": "../../etc/passwd",
        "capabilities": []
      }
    },
    {
      "case": "action within the granted scope",
      "expect_pass": true,
      "manifest": {
        "spec_version": "0.1",
        "id": "com.tcc.a",
        "name": "A",
        "version": "1",
        "publisher": "PUB",
        "scheme": "hybrid-ed25519-mldsa65-v1",
        "content_hash": "HASH",
        "entry": "ui.json",
        "capabilities": [
          {
            "name": "network",
            "scope": {
              "kind": "network",
              "hosts": [
                "shop.tcc-coin.com"
              ]
            },
            "reason": "tai hang"
          }
        ],
        "actions": [
          {
            "id": "tai-hang",
            "effect": {
              "kind": "fetch",
              "host": "shop.tcc-coin.com",
              "path": "/ds"
            }
          }
        ]
      }
    },
    {
      "case": "action calls a host never requested",
      "notes": "At run time the capability still blocks it — but the user has already clicked, nothing happened, and nobody knows why. Catching it in validate_shape tells the app author while they are still at their machine.",
      "expect_pass": false,
      "code": "action-host-not-granted",
      "manifest": {
        "spec_version": "0.1",
        "id": "com.tcc.a",
        "name": "A",
        "version": "1",
        "publisher": "PUB",
        "scheme": "hybrid-ed25519-mldsa65-v1",
        "content_hash": "HASH",
        "entry": "ui.json",
        "capabilities": [
          {
            "name": "network",
            "scope": {
              "kind": "network",
              "hosts": [
                "shop.tcc-coin.com"
              ]
            },
            "reason": "tai hang"
          }
        ],
        "actions": [
          {
            "id": "tai-hang",
            "effect": {
              "kind": "fetch",
              "host": "ke-gian.example",
              "path": "/ds"
            }
          }
        ]
      }
    },
    {
      "case": "action declared with no network capability requested",
      "expect_pass": false,
      "code": "action-host-not-granted",
      "manifest": {
        "spec_version": "0.1",
