{
 "description": "An interface tree arriving from a package must pass EXACTLY the checks a hand-written tree passes. No leniency for being data rather than code. See FORMAT.md.",
 "cases": [
  {
   "case": "minimal tree",
   "expect_pass": true,
   "tree": {
    "kind": "text",
    "content": "Xin chào"
   }
  },
  {
   "case": "fully nested tree",
   "expect_pass": true,
   "tree": {
    "kind": "group",
    "flow": "column",
    "gap": "large",
    "children": [
     {
      "kind": "text",
      "content": "TCC Store",
      "emphasis": "title"
     },
     {
      "kind": "field",
      "label": "Mật khẩu",
      "secret": true
     },
     {
      "kind": "image",
      "source": "anh/logo.png",
      "alt": {
       "kind": "text",
       "text": "Biểu trưng"
      }
     },
     {
      "kind": "button",
      "label": "Thanh toán",
      "action": "thanh-toan",
      "tone": "danger"
     }
    ]
   }
  },
  {
   "case": "button label contains a bidi override",
   "expect_pass": false,
   "code": "unsafe-display-string",
   "tree": {
    "kind": "button",
    "label": "Hu‮r",
    "action": "x"
   }
  },
  {
   "case": "image points at the network",
   "expect_pass": false,
   "code": "external-image",
   "tree": {
    "kind": "image",
    "source": "https://theo-doi.example/1.png",
    "alt": {
     "kind": "decorative"
    }
   }
  },
  {
   "case": "image escapes the package",
   "expect_pass": false,
   "code": "bad-path",
   "tree": {
    "kind": "image",
    "source": "../bi-mat.png",
    "alt": {
     "kind": "decorative"
    }
   }
  },
  {
   "case": "action id contains a space",
   "expect_pass": false,
   "code": "bad-action-id",
   "tree": {
    "kind": "button",
    "label": "A",
    "action": "cho phep"
   }
  },
  {
   "case": "action id contains uppercase",
   "expect_pass": false,
   "code": "bad-action-id",
   "tree": {
    "kind": "button",
    "label": "A",
    "action": "ChoPhep"
   }
  },
  {
   "case": "button label contains a newline",
   "expect_pass": false,
   "code": "unsafe-display-string",
   "tree": {
    "kind": "button",
    "label": "Đồng\ný",
    "action": "ok"
   }
  },
  {
   "case": "paragraph may contain newlines",
   "expect_pass": true,
   "tree": {
    "kind": "text",
    "content": "Dòng một\nDòng hai"
   }
  },
  {
   "case": "Vietnamese diacritics and emoji",
   "expect_pass": true,
   "tree": {
    "kind": "text",
    "content": "Chào bạn — số dư 3 TCC 🎉"
   }
  },
  {
   "case": "a script tag in text is ORDINARY TEXT, not an error",
   "notes": "The standard does NOT forbid this string — it contains no spoofing characters. Blocking it would be the renderer's job, and the renderer escapes it. Rejecting text for looking like markup is how you get an unusable standard.",
   "expect_pass": true,
   "tree": {
    "kind": "text",
    "content": "<script>alert(1)</script>"
   }
  },
  {
   "case": "image missing its description",
   "expect_pass": false,
   "code": "bad-json",
   "tree": {
    "kind": "image",
    "source": "a.png"
   }
  },
  {
   "case": "unknown field",
   "expect_pass": false,
   "code": "bad-json",
   "tree": {
    "kind": "text",
    "content": "x",
    "sample": "do"
   }
  },
  {
   "case": "node kind not in the standard",
   "expect_pass": false,
   "code": "bad-json",
   "tree": {
    "kind": "video",
    "source": "a.mp4"
   }
  },
  {
   "case": "button label with 20 marks on one character",
   "expect_pass": false,
   "code": "unsafe-display-string",
   "notes": "Drawn as a vertical streak covering the area above. In a permission dialog the area above is the identity warning — the thing the user must read before pressing anything.",
   "tree": {
    "kind": "button",
    "label": "Huỷ́́́́́́́́́́́́́́́́́́́́",
    "action": "huy"
   }
  },
  {
   "case": "DECOMPOSED Vietnamese must still pass",
   "notes": "The macOS input method commonly produces the decomposed form. Being over-strict here would ban Vietnamese itself, which is why the limit counts consecutive marks rather than banning them.",
   "expect_pass": true,
   "tree": {
    "kind": "text",
    "content": "Tiếng Việt có dáu"
   }
  },
  {
   "case": "a long sentence with many diacritics must still pass",
   "expect_pass": true,
   "tree": {
    "kind": "text",
    "content": "Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt Tiếng Việt "
   }
  },
  {
   "case": "leaf node given children",
   "expect_pass": false,
   "code": "bad-json",
   "tree": {
    "kind": "text",
    "content": "a",
    "children": [
     {
      "kind": "text",
      "content": "b"
     }
    ]
   },
   "notes": "A leaf kind has no `children` field, so a strict decoder rejects it as an unknown field before any tree rule runs. `not-a-container` therefore never arises from package input — see 06-error-codes.md."
  },
  {
   "case": "string over 4096 characters",
   "expect_pass": false,
   "code": "text-too-long",
   "tree": {
    "kind": "text",
    "content": ""
   }
  },
  {
   "case": "string at exactly 4096 characters",
   "expect_pass": true,
   "tree": {
    "kind": "text",
    "content": ""
   },
   "notes": "The limit is inclusive; an off-by-one here rejects a legal app."
  },
